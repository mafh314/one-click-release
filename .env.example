# One-click-release credentials
# Copy this file to .env and fill in the values.

# GitHub
# Used by: all steps (GitHub API via gh CLI)
# Alternatively, authenticate with: gh auth login
GITHUB_TOKEN=

# Used by: automated git commits (e.g. step 1.8 OPC version bump)
GITHUB_USER=
GITHUB_EMAIL=

# GitLab (gitlab.cee.redhat.com)
GITLAB_URL=https://gitlab.cee.redhat.com

# Verify commands (steps 1.5, 1.6, 1.11, 1.12): any read scope is sufficient.
# Execute commands (auto-create MRs): requires 'api' scope for write access.
#   Without 'api' scope, execute paths fall back to MANUAL instructions.
GITLAB_TOKEN=

# Konflux cluster
# Used by: steps that query Applications and Components on the Konflux cluster
KONFLUX_SERVER=
KONFLUX_TOKEN=

# Jira
# Used by: audit-release and jira-gaps skills
JIRA_URL=
JIRA_EMAIL=
JIRA_TOKEN=
